# SPDX-License-Identifier: GPL-2.0-or-later
# Phase 4-M RAM-only selector probe.
# U-Boot's pre-relocation env_get() scratch buffer is 32 bytes, so each
# command fragment is intentionally short.  All three operations only set
# input direction and read a GPIO; no NAND/env write or reset is included.

p4m_r=gpio read wsr_router 1
p4m_w=gpio read wsr_wb 16
p4m_m=gpio read wsr_manual 18
phase4m_selector_dryrun=run p4m_r;run p4m_w;run p4m_m
