# SPDX-License-Identifier: GPL-2.0-or-later
# Phase 4-M fixed-format read-only boot selector.
# The C command performs GPIO sampling, expected-format checks, NAND page
# conversion, DHP2/FIT bounds checks, and the final bootm call. It has no
# write, erase, repair, fallback, saveenv, or dual-image path.
phase4m_selector_final=wsrsel boot
bootcmd=run phase4m_selector_final
